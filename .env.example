# Copy this file to `.env` and fill in your own Azure OpenAI values.
# The app reads these as environment variables. No API keys are used —
# authentication is handled by Microsoft Entra ID via DefaultAzureCredential
# (run `az login` first, or use a managed identity).

# Your Azure OpenAI resource endpoint, e.g. https://my-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# The name of your deployed chat model (deployment name, not the base model name)
AZURE_OPENAI_DEPLOYMENT_NAME=

# API version to target
AZURE_OPENAI_API_VERSION=2024-08-01-preview
